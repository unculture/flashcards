{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flashcards",
  "version": "0.4.0",
  "identifier": "com.unculture.flashcards",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flashcards",
        "width": 1200,
        "height": 820,
        "minWidth": 640,
        "minHeight": 560,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
